# SNEP Certifications API - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
# For local development: postgresql://postgres:postgres@localhost:5432/snep
# For Supabase: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# For Railway/Render/Fly.io: use their provided connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snep

# Maximum database connections in the pool
DB_MAX_CONNECTIONS=10

# =============================================================================
# Server Configuration
# =============================================================================
# Host to bind to (0.0.0.0 for all interfaces)
HOST=0.0.0.0

# Port to listen on
PORT=3000

# Enable CORS for all origins (set to "false" in production with specific origins)
ENABLE_CORS=true

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: trace, debug, info, warn, error
# Format: crate=level, e.g., snep_certifications_api=debug,tower_http=info,sqlx=warn
RUST_LOG=info,snep_certifications_api=debug,tower_http=info,sqlx=warn

# =============================================================================
# Scraper Configuration
# =============================================================================
# Base URL for SNEP certifications
SNEP_BASE_URL=https://snepmusique.com/les-certifications/

# Delay between page requests in seconds (be respectful!)
SNEP_DELAY_SECONDS=1

# Maximum retries per page
SNEP_MAX_RETRIES=3

# Request timeout in seconds
SNEP_TIMEOUT_SECONDS=30

# =============================================================================
# Deployment-Specific (Fly.io, Railway, Render)
# =============================================================================
# Fly.io sets these automatically:
# PORT=8080
# DATABASE_URL=postgresql://...

# Railway sets these automatically:
# PORT=...
# DATABASE_URL=postgresql://...

# Render sets these automatically:
# PORT=...
# DATABASE_URL=postgresql://...

# For Supabase direct connection (not pooled):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# For Supabase pooled connection (recommended for serverless):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# =============================================================================
# Example Production Values
# =============================================================================
# DATABASE_URL=postgresql://postgres:your-secure-password@db.qxgareduswbtrmfsfhek.supabase.co:5432/postgres
# DB_MAX_CONNECTIONS=20
# PORT=8080
# ENABLE_CORS=false
# RUST_LOG=info